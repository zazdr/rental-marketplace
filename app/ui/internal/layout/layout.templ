package layout

import "app/ui/internal/component/header"

templ Layout(main templ.Component) {
	<!DOCTYPE html>
	<html>
		<head>
			<meta name="viewport" content="width=device-width"/>
			<link href="/static/css/tailwind.min.css" rel="stylesheet"/>
			<script src="/static/js/htmx.min.js" defer></script>
			<script src="/static/js/hyperscript.min.js" defer></script>
		</head>
		<body class="layout bg-red-700">
			<div class="layout__main container">
				@main
			</div>
			<div class="layout__header container">
				@header.Header()
			</div>
		</body>
	</html>
}
